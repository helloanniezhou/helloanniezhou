      "richText": [
        {
          "type": "text",
          "text": "Turning wearable insights into everyday guidance—from fitness tracking to AI-powered coaching."
        }
      ]
    },
    {
      "id": "health-overview-heading",
      "type": "heading_3",
      "richText": [
        {
          "type": "text",
          "text": "Overview",
          "bold": true
        }
      ]
    },
